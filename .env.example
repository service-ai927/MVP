# Reference only. The server has NO dotenv loader, so copying this file to .env
# has no effect - it is never read. Set these in the process environment instead:
#
#   # PowerShell
#   $env:GEMINI_API_KEY = "YOUR_GEMINI_API_KEY"; npm run dev
#
#   # bash / zsh
#   export GEMINI_API_KEY="YOUR_GEMINI_API_KEY"; npm run dev
#
# Variables the server actually reads (see README "Environment variables"):
#
#   GEMINI_API_KEY         optional  enables live Gemini classification and
#                                    draft generation. Without it the app uses
#                                    the rules engine and a labelled template
#                                    fallback. Never commit a real key.
#   GEMINI_MAX_RETRIES     optional  retries for transient Gemini errors
#                                    (429/5xx/timeouts). Defaults to 2.
#   PORT                  optional  defaults to 3000. 0 picks a free port.
#   HOST                   optional  bind address; defaults to 127.0.0.1
#                                    (loopback only). In production a
#                                    non-loopback HOST requires API_AUTH_TOKEN
#                                    or the server refuses to start.
#   NODE_ENV               optional  "production" serves the built dist/ bundle;
#                                    anything else runs the Vite dev server.
#   API_AUTH_TOKEN         optional  shared bearer token for non-loopback API
#                                    access (Authorization: Bearer <token>).
#   ALLOWED_ORIGINS        optional  comma-separated origins allowed CORS
#                                    access; no CORS headers without it.
#   RATE_LIMIT_PER_MINUTE  optional  /api request budget per address
#                                    (default 300; 0 disables).
#   MAX_THREADS            optional  cap on stored/imported threads
#                                    (default 5000).
#   ALLOW_SAMPLE_RESET     optional  "true" enables the destructive
#                                    POST /api/reset-samples endpoint.
#                                    Disposable instances only.
#   DATA_DIR               optional  persistence directory (default .data).
#
# Never commit a real key.
PORT=3000
